# RideFlow configuration template.
#
#   cp .env.example .env
#
# .env is gitignored and MUST NOT be committed. This file documents every
# variable the platform reads, with safe local defaults (PROJECT_PLAN.md 6.5).
# No real credentials belong in either file - all data is synthetic and there is
# no PII anywhere in the system by design.

# ── Kafka ────────────────────────────────────────────────────────────────────
# 29092 is the HOST-facing listener. Processes running on the host (generator,
# consumer) use this. Anything running inside the Compose network uses
# broker:9092 instead - "localhost" would resolve to the container itself.
KAFKA_BOOTSTRAP_SERVERS=localhost:29092

KAFKA_TOPIC_TRIPS=rideflow.trips.events.v1
KAFKA_TOPIC_PRESENCE=rideflow.drivers.presence.v1
KAFKA_TOPIC_TRIPS_DLQ=rideflow.trips.events.dlq.v1
KAFKA_TOPIC_PRESENCE_DLQ=rideflow.drivers.presence.dlq.v1

# ── Producer ─────────────────────────────────────────────────────────────────
# acks=all waits for every in-sync replica. acks=1 risks silent loss if the
# leader fails after acknowledging but before replicating.
KAFKA_ACKS=all

# Prevents PRODUCER-side duplicates from internal retries. Distinct from the
# consumer-side deduplication in staging - this eliminates one duplicate source
# at its origin rather than cleaning it up later.
KAFKA_ENABLE_IDEMPOTENCE=true

KAFKA_RETRIES=10

# 5 is the maximum that still preserves ordering WHEN idempotence is enabled.
# Without idempotence, in-flight > 1 plus retries silently reorders messages.
KAFKA_MAX_IN_FLIGHT=5

KAFKA_LINGER_MS=10
KAFKA_DELIVERY_TIMEOUT_MS=120000

# snappy over gzip: far cheaper CPU for a modest ratio cost, which is the right
# trade on a high-throughput streaming path.
KAFKA_COMPRESSION_TYPE=snappy

# ── Consumer (M4) ────────────────────────────────────────────────────────────
KAFKA_CONSUMER_GROUP_TRIPS=rideflow-trip-ingestor
KAFKA_CONSUMER_GROUP_PRESENCE=rideflow-presence-ingestor

# The most important consumer setting in the platform. Auto-commit commits on a
# timer regardless of whether processing succeeded, so a crash between the
# auto-commit and a durable write loses data silently.
KAFKA_ENABLE_AUTO_COMMIT=false

# earliest, not latest: on a new group or a lost offset, start from the
# beginning. "latest" would silently skip unprocessed history.
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_MAX_POLL_RECORDS=500
KAFKA_SESSION_TIMEOUT_MS=45000

# ── Generator ────────────────────────────────────────────────────────────────
# Identical seed must produce byte-identical output.
RIDEFLOW_SEED=42
RIDEFLOW_CITY=BLR
RIDEFLOW_TRIPS_PER_HOUR=600
RIDEFLOW_ENVIRONMENT=local

# ── Paths ────────────────────────────────────────────────────────────────────
# The landing zone is the system of record: append-only, never mutated, and the
# only component the platform cannot rebuild from something else.
RIDEFLOW_LANDING_ZONE=data/raw
RIDEFLOW_WAREHOUSE_PATH=data/warehouse/rideflow.duckdb
RIDEFLOW_MART_EXPORT=data/processed
